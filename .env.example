# Copy to .env and adjust. Every value can also be set as an environment variable.

# Root for everything the app stores. The paths below default to subfolders of it.
RECEIPT_TRACKER_DATA_DIR=./var

# RECEIPT_TRACKER_DB_PATH=./var/receipt_tracker.db
# RECEIPT_TRACKER_WATCH_DIR=./var/inbox
# RECEIPT_TRACKER_ARCHIVE_DIR=./var/archive

# How often `watch` scans the folder, and how long a photo must sit unmodified
# before it is picked up (so a file still being copied in is not read half-written).
# RECEIPT_TRACKER_WATCH_INTERVAL_SECONDS=10
# RECEIPT_TRACKER_WATCH_SETTLE_SECONDS=5

# Local model server (Ollama) used by extraction workers.
RECEIPT_TRACKER_MODEL_SERVER_URL=http://localhost:11434

RECEIPT_TRACKER_HOST=127.0.0.1
RECEIPT_TRACKER_PORT=8000
