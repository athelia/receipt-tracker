# Copy to .env and adjust. Every value can also be set as an environment variable.

# Root for everything the app stores. The paths below default to subfolders of it.
RECEIPT_TRACKER_DATA_DIR=./var

# RECEIPT_TRACKER_DB_PATH=./var/receipt_tracker.db
# RECEIPT_TRACKER_WATCH_DIR=./var/inbox
# RECEIPT_TRACKER_ARCHIVE_DIR=./var/archive

# How often `watch` scans the folder, and how long a photo must sit unmodified
# before it is picked up (so a file still being copied in is not read half-written).
# RECEIPT_TRACKER_WATCH_INTERVAL_SECONDS=10
# RECEIPT_TRACKER_WATCH_SETTLE_SECONDS=5

# Local model server (Ollama) used by extraction workers.
RECEIPT_TRACKER_MODEL_SERVER_URL=http://localhost:11434

# Vision extractor: crop the background away around the receipt before sending it.
# RECEIPT_TRACKER_VISION_CROP=true

# A receipt taller than this multiple of its width is cut into overlapping tiles.
# RECEIPT_TRACKER_VISION_MAX_ASPECT=4

# While waiting for the model, log a "still waiting" line this often (0 = off).
# RECEIPT_TRACKER_VISION_PROGRESS_SECONDS=30

# Structured event logs (JSON lines, one rotating file per process).
# RECEIPT_TRACKER_LOG_DIR=./var/logs
# RECEIPT_TRACKER_LOG_LEVEL=INFO
# Print each event as a readable line on stderr, to watch a run live.
# RECEIPT_TRACKER_LOG_CONSOLE=false
# Keep the raw model answer of failed extractions in raw-failures.jsonl.
# It contains receipt text, so it is off by default.
# RECEIPT_TRACKER_LOG_RAW_FAILURES=false

RECEIPT_TRACKER_HOST=127.0.0.1
RECEIPT_TRACKER_PORT=8000
